{
  "name": "rem",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @rem/db generate",
    "db:migrate": "pnpm --filter @rem/db migrate",
    "db:seed": "pnpm --filter @rem/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
